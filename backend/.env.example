# Environment reference: export variables before starting PHP.
# .env files are NOT automatically loaded. See backend/README.md.
# Copy to backend/.env for future local use. Never use production credentials locally.
APP_ENV=local
APP_URL=http://127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_LOCAL_DATABASE
DB_USERNAME=CHANGE_ME_LOCAL_USER
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
# Private writable absolute paths; supply local paths before future implementation.
PRIVATE_STORAGE_PATH=CHANGE_ME_PRIVATE_ABSOLUTE_PATH
PRODUCT_UPLOAD_PATH=CHANGE_ME_LOCAL_PUBLIC_UPLOAD_PATH
# Hard ceiling; server limits may be stricter.
UPLOAD_MAX_BYTES=5242880
